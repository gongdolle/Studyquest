{
  "name": "studyquest",
  "productName": "StudyQuest",
  "version": "0.1.4",
  "private": true,
  "license": "Beerware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongdolle/Studyquest.git"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "description": "Portable AI-powered dynamic learning quest desktop app",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "package:portable": "npm run build && node scripts/package.mjs",
    "package:release": "npm run package:portable && node scripts/stage-release.mjs && npm run verify:release",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.146.0",
    "ajv": "8.20.0",
    "lucide-react": "1.28.0",
    "officeparser": "7.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron/packager": "20.1.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.2.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
