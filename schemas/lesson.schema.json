{
  "type": "object",
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "segments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "phase": { "type": "string", "enum": ["orient", "explain", "example", "explore", "synthesize"] },
          "minutes": { "type": "integer", "minimum": 1, "maximum": 60 },
          "heading": { "type": "string", "minLength": 1, "maxLength": 300 },
          "content": { "type": "string", "minLength": 120, "maxLength": 8000 },
          "readingGuide": { "type": "string", "minLength": 1, "maxLength": 500 },
          "widget": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "kind": { "type": "string", "enum": ["stepper", "comparison", "parameter-sweep"] },
                  "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "instruction": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
                        "body": { "type": "string", "minLength": 1, "maxLength": 1000 },
                        "value": { "type": "number", "minimum": 0, "maximum": 100 }
                      },
                      "required": ["label", "body", "value"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["id", "kind", "title", "instruction", "items"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "kind": { "type": "string", "enum": ["sandbox-lab"] },
                  "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "instruction": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "html": { "type": "string", "minLength": 1, "maxLength": 20000 },
                  "css": { "type": "string", "minLength": 1, "maxLength": 20000 },
                  "javascript": { "type": "string", "minLength": 1, "maxLength": 30000 },
                  "height": { "type": "integer", "minimum": 260, "maximum": 720 }
                },
                "required": ["id", "kind", "title", "instruction", "html", "css", "javascript", "height"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["phase", "minutes", "heading", "content", "readingGuide", "widget"],
        "additionalProperties": false
      }
    },
    "finalCheck": {
      "type": "object",
      "properties": {
        "intro": { "type": "string", "minLength": 1, "maxLength": 500 },
        "questions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 100 },
              "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "options": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": { "type": "string", "minLength": 1, "maxLength": 500 }
              },
              "correctIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
              "explanation": { "type": "string", "minLength": 1, "maxLength": 1000 }
            },
            "required": ["id", "prompt", "options", "correctIndex", "explanation"],
            "additionalProperties": false
          }
        }
      },
      "required": ["intro", "questions"],
      "additionalProperties": false
    },
    "successEvidence": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "reviewPrompt": { "type": "string", "minLength": 1, "maxLength": 1000 }
  },
  "required": ["title", "objective", "segments", "finalCheck", "successEvidence", "reviewPrompt"],
  "additionalProperties": false
}
